{%- assign social_link = section.settings.link | default: settings.social_instagram_link -%}

<section class="m2-top-social m2-top-width" aria-labelledby="M2TopSocialHeading-{{ section.id }}">
  <div class="m2-top-heading m2-top-heading--row">
    <p id="M2TopSocialHeading-{{ section.id }}" class="m2-top-label">{{ section.settings.eyebrow | escape }}</p>
    {%- if social_link != blank -%}
      <a class="m2-top-text-link" href="{{ social_link }}" target="_blank" rel="noopener">{{ section.settings.button_label | escape }} <span aria-hidden="true">›</span></a>
    {%- endif -%}
  </div>

  <div class="m2-top-social__grid">
    {%- for block in section.blocks -%}
      {%- assign item_link = block.settings.link | default: social_link -%}
      <div class="m2-top-social__card" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{
            block.settings.image
            | image_url: width: 700
            | image_tag:
              widths: '240, 360, 480, 700',
              sizes: '(min-width: 1024px) 204px, 45vw',
              loading: 'lazy',
              alt: block.settings.accessibility_label
          }}
        {%- else -%}
          <span class="m2-top-social__placeholder" aria-hidden="true"></span>
        {%- endif -%}
        {%- if item_link != blank -%}
          <a href="{{ item_link }}" target="_blank" rel="noopener" aria-label="{{ block.settings.accessibility_label | default: section.settings.eyebrow | escape }}"></a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "M2 TOP Instagram",
  "tag": "div",
  "class": "m2-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "見出し", "default": "INSTAGRAM" },
    { "type": "url", "id": "link", "label": "アカウントURL", "info": "未入力時はテーマ設定のInstagram URLを使用します。" },
    { "type": "text", "id": "button_label", "label": "リンク名", "default": "VIEW MORE" }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "投稿画像",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "画像" },
        { "type": "url", "id": "link", "label": "投稿URL" },
        { "type": "text", "id": "accessibility_label", "label": "画像の説明", "default": "Instagram投稿" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "M2 TOP Instagram",
      "blocks": [{ "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }]
    }
  ]
}
{% endschema %}
