{{ 'm2-contact.css' | asset_url | stylesheet_tag }}
<script src="{{ 'm2-contact.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign contact_form_id = 'M2ContactForm-' | append: section.id
  assign privacy_url = section.settings.privacy_link
  if privacy_url == blank and shop.privacy_policy != blank
    assign privacy_url = shop.privacy_policy.url
  endif
  if privacy_url == blank
    assign privacy_url = routes.root_url
  endif

-%}

{%- form 'contact', id: contact_form_id, class: 'm2-contact-form' -%}
  {%- liquid
    assign submitted_topic = form['お問い合わせ項目']
    assign submitted_family_name = form['姓']
    assign submitted_given_name = form['名']
    assign submitted_phone = form['電話番号']
    assign submitted_order_number = form['注文No']
  -%}
  <section
    class="m2-contact-page"
    data-m2-contact
    data-m2-state="{% if form.posted_successfully? %}success{% else %}input{% endif %}"
    aria-labelledby="M2ContactHeading-{{ section.id }}"
  >
    {%- if section.settings.show_breadcrumb -%}
      <nav class="m2-contact-page__breadcrumb" aria-label="パンくずリスト">
        <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_parent | escape }}</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{{ section.settings.breadcrumb_current | escape }}</span>
      </nav>
    {%- endif -%}

    <header class="m2-contact-page__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="m2-contact-page__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 id="M2ContactHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
    </header>

    <div class="m2-contact-page__body">
      {%- if form.posted_successfully? -%}
        <div class="m2-contact-success" data-m2-view="success">
          <div class="m2-contact-success__panel">
            <h2 class="m2-contact-success__heading" tabindex="-1" data-m2-state-heading>
              <img src="{{ 'm2-contact-success-check.svg' | asset_url }}" width="27" height="27" alt="">
              <span>{{ section.settings.success_heading | escape }}</span>
            </h2>
            <div class="m2-contact-success__copy rte">{{ section.settings.success_text }}</div>
          </div>
          <a class="m2-contact-button m2-contact-button--home" href="{{ routes.root_url }}">
            {{- section.settings.home_label | escape -}}
          </a>
        </div>
      {%- else -%}
        <div class="m2-contact-input" data-m2-view="input">
          <h2 class="visually-hidden" tabindex="-1" data-m2-state-heading>お問い合わせ内容の入力</h2>

          {%- if form.errors -%}
            <div class="m2-contact-server-error" role="alert" tabindex="-1" data-m2-server-error>
              <h3>{{ 'templates.contact.form.error_heading' | t }}</h3>
              <ul role="list">
                {%- for field in form.errors -%}
                  <li>
                    {%- if field == 'form' -%}
                      {{ form.errors.messages[field] }}
                    {%- else -%}
                      <a href="#{{ contact_form_id }}-{{ field }}">
                        {{- form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] -}}
                      </a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="m2-contact-fields">
            <fieldset class="m2-contact-choice-group">
              <legend class="m2-contact-label-row">
                <span>お問い合わせ項目</span>
                <span class="m2-contact-required">必須</span>
              </legend>
              <div class="m2-contact-choice-list">
                {%- assign contact_topics = '商品について|ご注文について|発送・お支払いについて|返品・交換について|会員登録について|PR・取材について|その他' | split: '|' -%}
                {%- for topic in contact_topics -%}
                  {%- assign topic_id = contact_form_id | append: '-topic-' | append: forloop.index -%}
                  <label class="m2-contact-choice" for="{{ topic_id }}">
                    <input
                      type="radio"
                      id="{{ topic_id }}"
                      name="contact[お問い合わせ項目]"
                      value="{{ topic | escape }}"
                      {% if submitted_topic == topic or submitted_topic == blank and forloop.first %}checked{% endif %}
                      {% if forloop.first %}required aria-required="true"{% endif %}
                      aria-describedby="{{ contact_form_id }}-topic-error"
                      data-required-message="お問い合わせ項目を選択してください"
                    >
                    <span>{{ topic | escape }}</span>
                  </label>
                {%- endfor -%}
              </div>
              <p class="m2-contact-error" id="{{ contact_form_id }}-topic-error" hidden>
                お問い合わせ項目を選択してください
              </p>
            </fieldset>

            <div class="m2-contact-name-fields">
              <div class="m2-contact-field">
                <label class="m2-contact-label-row" for="{{ contact_form_id }}-family-name">
                  <span>姓</span>
                  <span class="m2-contact-required">必須</span>
                </label>
                <input
                  type="text"
                  id="{{ contact_form_id }}-family-name"
                  name="contact[姓]"
                  value="{% if submitted_family_name != blank %}{{ submitted_family_name | escape }}{% elsif customer %}{{ customer.last_name | escape }}{% endif %}"
                  placeholder="山田"
                  autocomplete="family-name"
                  required
                  aria-required="true"
                  aria-describedby="{{ contact_form_id }}-family-name-error"
                  data-required-message="姓を入力してください"
                >
                <p class="m2-contact-error" id="{{ contact_form_id }}-family-name-error" hidden>姓を入力してください</p>
              </div>

              <div class="m2-contact-field">
                <label class="m2-contact-label-row" for="{{ contact_form_id }}-given-name">
                  <span>名</span>
                  <span class="m2-contact-required">必須</span>
                </label>
                <input
                  type="text"
                  id="{{ contact_form_id }}-given-name"
                  name="contact[名]"
                  value="{% if submitted_given_name != blank %}{{ submitted_given_name | escape }}{% elsif customer %}{{ customer.first_name | escape }}{% endif %}"
                  placeholder="太朗"
                  autocomplete="given-name"
                  required
                  aria-required="true"
                  aria-describedby="{{ contact_form_id }}-given-name-error"
                  data-required-message="名を入力してください"
                >
                <p class="m2-contact-error" id="{{ contact_form_id }}-given-name-error" hidden>名を入力してください</p>
              </div>
            </div>

            <div class="m2-contact-field{% if form.errors contains 'email' %} is-invalid{% endif %}">
              <div class="m2-contact-field__heading">
                <label class="m2-contact-label-row" for="{{ contact_form_id }}-email">
                  <span>メールアドレス</span>
                  <span class="m2-contact-required">必須</span>
                </label>
                <p
                  class="m2-contact-error"
                  id="{{ contact_form_id }}-email-error"
                  {% unless form.errors contains 'email' %}hidden{% endunless %}
                >
                  {%- if form.errors contains 'email' -%}
                    {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
                  {%- else -%}
                    正しいメールアドレスを入力してください
                  {%- endif -%}
                </p>
              </div>
              <input
                type="email"
                id="{{ contact_form_id }}-email"
                name="contact[email]"
                value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"
                placeholder="sample@mail.com"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                required
                aria-required="true"
                aria-describedby="{{ contact_form_id }}-email-error"
                {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
                data-required-message="メールアドレスを入力してください"
                data-invalid-message="正しいメールアドレスを入力してください"
              >
            </div>

            <div class="m2-contact-field">
              <label class="m2-contact-label-row" for="{{ contact_form_id }}-phone">
                <span>電話番号</span>
                <span class="m2-contact-required">必須</span>
              </label>
              <input
                type="tel"
                id="{{ contact_form_id }}-phone"
                name="contact[電話番号]"
                value="{% if submitted_phone != blank %}{{ submitted_phone | escape }}{% elsif customer %}{{ customer.phone | escape }}{% endif %}"
                placeholder="09012345678"
                autocomplete="tel"
                inputmode="tel"
                required
                aria-required="true"
                aria-describedby="{{ contact_form_id }}-phone-error"
                data-required-message="電話番号を入力してください"
              >
              <p class="m2-contact-error" id="{{ contact_form_id }}-phone-error" hidden>電話番号を入力してください</p>
            </div>

            <div class="m2-contact-field">
              <label class="m2-contact-label-row" for="{{ contact_form_id }}-order-number">
                <span>注文No</span>
              </label>
              <input
                type="text"
                id="{{ contact_form_id }}-order-number"
                name="contact[注文No]"
                value="{{ submitted_order_number | escape }}"
                placeholder="123456789"
                autocomplete="off"
              >
            </div>

            <div class="m2-contact-field">
              <label class="m2-contact-label-row" for="{{ contact_form_id }}-body">
                <span>お問い合わせ内容</span>
                <span class="m2-contact-required">必須</span>
              </label>
              <textarea
                id="{{ contact_form_id }}-body"
                name="contact[body]"
                placeholder="お気軽にご記入ください"
                autocomplete="off"
                required
                aria-required="true"
                aria-describedby="{{ contact_form_id }}-body-error"
                data-required-message="お問い合わせ内容を入力してください"
              >{{ form.body | escape }}</textarea>
              <p class="m2-contact-error" id="{{ contact_form_id }}-body-error" hidden>
                お問い合わせ内容を入力してください
              </p>
            </div>
          </div>

          <div class="m2-contact-input__actions">
            <div class="m2-contact-consent">
              <label for="{{ contact_form_id }}-privacy">
                <input
                  type="checkbox"
                  id="{{ contact_form_id }}-privacy"
                  required
                  aria-required="true"
                  aria-describedby="{{ contact_form_id }}-privacy-error"
                  data-required-message="プライバシーポリシーへの同意が必要です"
                >
                <span><a href="{{ privacy_url }}">プライバイシーポリシー</a>に同意します。</span>
              </label>
              <p class="m2-contact-error" id="{{ contact_form_id }}-privacy-error" hidden>
                プライバシーポリシーへの同意が必要です
              </p>
            </div>
            <button class="m2-contact-button" type="submit" data-m2-review-button>確認する</button>
          </div>
        </div>

        <div class="m2-contact-confirm" data-m2-view="confirm" hidden>
          <h2 class="visually-hidden" tabindex="-1" data-m2-state-heading>入力内容の確認</h2>
          <dl class="m2-contact-confirm__panel">
            <div class="m2-contact-confirm__row">
              <dt>お問い合わせ項目</dt>
              <dd data-m2-confirm-output="topic"></dd>
            </div>
            <div class="m2-contact-confirm__row">
              <dt>お名前</dt>
              <dd data-m2-confirm-output="name"></dd>
            </div>
            <div class="m2-contact-confirm__row">
              <dt>メールアドレス</dt>
              <dd data-m2-confirm-output="email"></dd>
            </div>
            <div class="m2-contact-confirm__row">
              <dt>電話番号</dt>
              <dd data-m2-confirm-output="phone"></dd>
            </div>
            <div class="m2-contact-confirm__row">
              <dt>注文No</dt>
              <dd data-m2-confirm-output="order-number"></dd>
            </div>
            <div class="m2-contact-confirm__row m2-contact-confirm__row--body">
              <dt>お問い合わせ内容</dt>
              <dd data-m2-confirm-output="body"></dd>
            </div>
          </dl>
          <div class="m2-contact-confirm__actions">
            <button class="m2-contact-button m2-contact-button--secondary" type="button" data-m2-back-button>
              修正する
            </button>
            <button class="m2-contact-button" type="submit" data-m2-final-submit>
              <span data-m2-submit-label>送信する</span>
            </button>
          </div>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endform -%}

{% schema %}
{
  "name": "M2 お問い合わせ",
  "tag": "div",
  "class": "m2-contact-section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumb", "label": "パンくずを表示", "default": true },
    { "type": "text", "id": "breadcrumb_parent", "label": "パンくず親ラベル", "default": "TOP" },
    { "type": "text", "id": "breadcrumb_current", "label": "パンくず現在地", "default": "お問い合わせ" },
    { "type": "text", "id": "eyebrow", "label": "英字見出し", "default": "CONTACT" },
    { "type": "text", "id": "heading", "label": "日本語見出し", "default": "お問い合わせ" },
    { "type": "url", "id": "privacy_link", "label": "プライバシーポリシーリンク" },
    { "type": "header", "content": "送信完了画面" },
    { "type": "text", "id": "success_heading", "label": "完了見出し", "default": "お問い合わせを受け付けました" },
    {
      "type": "richtext",
      "id": "success_text",
      "label": "完了本文",
      "default": "<p>お問い合わせいただきありがとうございます。<br>内容を確認の上、担当者より順次ご連絡いたします。今しばらくお待ちくださいませ。</p><p>ご入力いただいたメールアドレスに自動返信メールをお送りしております。<br>届かない場合は、迷惑メールフォルダをご確認いただくか、お手数ですがお電話にてお問い合わせください。</p>"
    },
    { "type": "text", "id": "home_label", "label": "TOPボタン名", "default": "TOPに戻る" }
  ],
  "presets": [{ "name": "M2 お問い合わせ" }]
}
{% endschema %}
