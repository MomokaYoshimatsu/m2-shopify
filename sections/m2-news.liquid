{%- assign selected_blog = section.settings.blog -%}
{%- liquid
  assign should_render = false
  if selected_blog != blank and selected_blog.articles_count > 0
    assign should_render = true
  elsif request.design_mode
    assign should_render = true
  endif
-%}

{%- if should_render -%}
  <section class="m2-top-news m2-top-width" id="news" aria-labelledby="M2TopNewsHeading-{{ section.id }}">
    <div class="m2-top-heading m2-top-heading--row">
      <div>
        <p class="m2-top-label">{{ section.settings.eyebrow | escape }}</p>
        <h2 id="M2TopNewsHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.show_view_all and selected_blog.url != blank -%}
        <a class="m2-top-text-link" href="{{ selected_blog.url }}">{{ section.settings.view_all_label | escape }} <span aria-hidden="true">›</span></a>
      {%- endif -%}
    </div>

    {%- if selected_blog != blank and selected_blog.articles_count > 0 -%}
      <div class="m2-top-news__list">
        {%- for article in selected_blog.articles limit: section.settings.articles_to_show -%}
          <article class="m2-top-news__item">
            <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%Y.%m.%d' }}</time>
            <span class="m2-top-news__tag">{{ article.tags.first | default: section.settings.default_tag | escape }}</span>
            <h3><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
          </article>
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="m2-top-editor-note">テーマエディターで記事のあるブログを選択してください。</p>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "M2 TOP お知らせ",
  "tag": "div",
  "class": "m2-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "英字見出し", "default": "NEWS" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "お知らせ" },
    { "type": "blog", "id": "blog", "label": "ブログ" },
    { "type": "range", "id": "articles_to_show", "min": 2, "max": 8, "step": 1, "label": "表示記事数", "default": 3 },
    { "type": "text", "id": "default_tag", "label": "タグがない場合の表示", "default": "INFO" },
    { "type": "checkbox", "id": "show_view_all", "label": "一覧リンクを表示", "default": true },
    { "type": "text", "id": "view_all_label", "label": "一覧リンク名", "default": "VIEW MORE" }
  ],
  "presets": [{ "name": "M2 TOP お知らせ" }]
}
{% endschema %}
