{%- assign selected_blog = section.settings.blog -%}
{%- liquid
  assign should_render = false
  if selected_blog != blank and selected_blog.articles_count > 0
    assign should_render = true
  elsif request.design_mode
    assign should_render = true
  endif
-%}

{%- if should_render -%}
  <section class="m2-section m2-section--{{ section.settings.background }}">
  <div class="m2-container">
    <div class="m2-section-header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="m2-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="m2-heading m2-heading--md">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    {%- if selected_blog != blank and selected_blog.articles_count > 0 -%}
      <div class="m2-news-list">
        {%- for article in selected_blog.articles limit: section.settings.articles_to_show -%}
          <article class="m2-news-item">
            <time class="m2-news-item__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
              {{ article.published_at | date: '%Y.%m.%d' }}
            </time>
            <span class="m2-news-item__tag">{{ article.tags.first | default: section.settings.default_tag | escape }}</span>
            <h3 class="m2-news-item__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
          </article>
        {%- endfor -%}
      </div>
      {%- if section.settings.show_view_all -%}
        <div class="m2-news__action">
          <a class="m2-link" href="{{ selected_blog.url }}">{{ section.settings.view_all_label | escape }}</a>
        </div>
      {%- endif -%}
    {%- elsif request.design_mode -%}
      <p class="m2-copy">テーマエディターで記事のあるブログを選択してください。</p>
    {%- endif -%}
  </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "M2 お知らせ",
  "tag": "div",
  "class": "m2-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "英字ラベル",
      "default": "INFO"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "お知らせ"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "ブログ"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "表示記事数",
      "default": 3
    },
    {
      "type": "text",
      "id": "default_tag",
      "label": "タグがない場合の表示",
      "default": "NEWS"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "一覧リンクを表示",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "一覧リンク名",
      "default": "VIEW ALL"
    },
    {
      "type": "select",
      "id": "background",
      "label": "背景",
      "options": [
        { "value": "paper", "label": "白" },
        { "value": "soft", "label": "ライトグレー" },
        { "value": "sand", "label": "ベージュ" }
      ],
      "default": "soft"
    }
  ],
  "presets": [
    {
      "name": "M2 お知らせ"
    }
  ]
}
{% endschema %}
