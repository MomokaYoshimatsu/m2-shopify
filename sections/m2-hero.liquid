{%- liquid
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.mobile_image | default: desktop_image
-%}

<section class="m2-top-hero" aria-labelledby="M2TopHeroHeading-{{ section.id }}">
  <picture class="m2-top-hero__media" aria-hidden="true">
    {%- if mobile_image != blank -%}
      <source
        media="(max-width: 1023px)"
        srcset="{{ mobile_image | image_url: width: 480 }} 480w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1000 }} 1000w"
        sizes="100vw"
      >
    {%- endif -%}
    {%- if desktop_image != blank -%}
      {{
        desktop_image
        | image_url: width: 2880
        | image_tag:
          widths: '1024, 1280, 1440, 1920, 2400, 2880',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high'
      }}
    {%- else -%}
      <img
        src="{{ 'm2-top-hero.jpg' | asset_url }}"
        alt=""
        width="2880"
        height="1392"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
  </picture>

  <div class="m2-top-hero__inner">
    {%- if section.settings.heading != blank -%}
      {%- assign heading_lines = section.settings.heading | newline_to_br | split: '<br />' -%}
      <h2 id="M2TopHeroHeading-{{ section.id }}" class="m2-top-hero__heading">
        {%- for heading_line in heading_lines -%}
          <span>{{ heading_line | strip | escape }}</span>
        {%- endfor -%}
      </h2>
    {%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a class="m2-top-button m2-top-button--light" href="{{ section.settings.button_link }}">
        {{ section.settings.button_label | escape }}
      </a>
    {%- endif -%}
  </div>

  {%- if section.settings.show_pagination -%}
    <div class="m2-top-hero__pagination" aria-hidden="true"><i></i><i></i><i></i></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "M2 TOP ヒーロー",
  "tag": "div",
  "class": "m2-section-wrapper",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "見出し",
      "default": "360度、\n自信に満ちた\n輝きへ。"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "PC画像",
      "info": "未設定時はFigmaのキービジュアルを表示します。"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "スマートフォン画像"
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "スライド位置の装飾を表示",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "ボタン名"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "ボタンリンク"
    }
  ],
  "presets": [
    {
      "name": "M2 TOP ヒーロー"
    }
  ]
}
{% endschema %}
