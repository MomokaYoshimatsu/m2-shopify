<m2-hero-slider
  class="m2-top-hero"
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.change_slides_speed | times: 1000 }}"
  aria-roledescription="カルーセル"
  aria-label="メインビジュアル"
>
  <div class="m2-top-hero__slides" aria-live="polite">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign desktop_image = block.settings.image | default: section.settings.image
          assign mobile_image = block.settings.mobile_image | default: section.settings.mobile_image
          assign slide_link = block.settings.link
          assign slide_link_label = desktop_image.alt | default: mobile_image.alt
          if slide_link_label == blank
            capture slide_link_label
              echo 'スライド '
              echo forloop.index
            endcapture
          endif
          assign image_loading = 'lazy'
          assign image_fetchpriority = 'auto'
          if forloop.first
            assign image_loading = 'eager'
            assign image_fetchpriority = 'high'
          endif
        -%}
        <article
          class="m2-top-hero__slide{% if forloop.first %} is-active{% endif %}"
          data-m2-hero-slide
          aria-roledescription="スライド"
          aria-label="{{ forloop.index }} / {{ section.blocks.size }}"
          aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
          {% unless forloop.first %}inert{% endunless %}
          {{ block.shopify_attributes }}
        >
          {%- if slide_link != blank -%}
            <a
              class="m2-top-hero__link"
              href="{{ slide_link }}"
              aria-label="{{ slide_link_label | strip | escape }}"
              data-m2-hero-link
            >
          {%- endif -%}
          <picture class="m2-top-hero__media" aria-hidden="true">
            {%- if mobile_image != blank -%}
              <source
                media="(max-width: 1023px)"
                srcset="{{ mobile_image | image_url: width: 480 }} 480w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1000 }} 1000w"
                sizes="100vw"
              >
            {%- else -%}
              <source media="(max-width: 1023px)" srcset="{{ 'kv01_sp.jpg' | asset_url }}">
            {%- endif -%}
            {%- if desktop_image != blank -%}
              {{
                desktop_image
                | image_url: width: 2880
                | image_tag:
                  widths: '1024, 1280, 1440, 1920, 2400, 2880',
                  sizes: '100vw',
                  loading: image_loading,
                  fetchpriority: image_fetchpriority
              }}
            {%- else -%}
              <img
                src="{{ 'kv01_pc.jpg' | asset_url }}"
                alt=""
                width="2880"
                height="1392"
                loading="{{ image_loading }}"
                fetchpriority="{{ image_fetchpriority }}"
              >
            {%- endif -%}
          </picture>
          {%- if slide_link != blank -%}
            </a>
          {%- endif -%}

        </article>
      {%- endfor -%}
    {%- else -%}
      {%- liquid
        assign desktop_image = section.settings.image
        assign mobile_image = section.settings.mobile_image
      -%}
      <article class="m2-top-hero__slide is-active" data-m2-hero-slide aria-hidden="false">
        <picture class="m2-top-hero__media" aria-hidden="true">
          {%- if mobile_image != blank -%}
            <source
              media="(max-width: 1023px)"
              srcset="{{ mobile_image | image_url: width: 480 }} 480w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1000 }} 1000w"
              sizes="100vw"
            >
          {%- else -%}
            <source media="(max-width: 1023px)" srcset="{{ 'kv01_sp.jpg' | asset_url }}">
          {%- endif -%}
          {%- if desktop_image != blank -%}
            {{ desktop_image | image_url: width: 2880 | image_tag: widths: '1024, 1280, 1440, 1920, 2400, 2880', sizes: '100vw', loading: 'eager', fetchpriority: 'high' }}
          {%- else -%}
            <img src="{{ 'kv01_pc.jpg' | asset_url }}" alt="" width="2880" height="1392" loading="eager" fetchpriority="high">
          {%- endif -%}
        </picture>
      </article>
    {%- endif -%}
  </div>

  {%- if section.settings.show_pagination and section.blocks.size > 1 -%}
    <div class="m2-top-hero__pagination" role="group" aria-label="スライドを選択">
      {%- for block in section.blocks -%}
        <button
          type="button"
          data-m2-hero-indicator="{{ forloop.index0 }}"
          aria-label="スライド{{ forloop.index }}を表示"
          aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</m2-hero-slider>

{% schema %}
{
  "name": "M2 TOP ヒーロー",
  "tag": "div",
  "class": "m2-section-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "共通のPC画像",
      "info": "各スライドで画像が未設定の場合に使用します。未設定時はkv01_pc.jpgを表示します。"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "共通のスマートフォン画像"
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "スライドインジケーターを表示",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "自動再生する",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "秒",
      "label": "スライド切り替え間隔",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "スライド",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "PC画像" },
        { "type": "image_picker", "id": "mobile_image", "label": "スマートフォン画像" },
        { "type": "url", "id": "link", "label": "遷移先URL" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "M2 TOP ヒーロー",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
