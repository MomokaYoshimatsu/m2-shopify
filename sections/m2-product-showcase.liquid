{%- assign selected_collection = section.settings.collection -%}
{%- liquid
  assign should_render = false
  if selected_collection != blank and selected_collection.products_count > 0
    assign should_render = true
  elsif request.design_mode
    assign should_render = true
  endif
-%}

{%- if should_render -%}
  <section class="m2-top-products m2-top-width" id="products" aria-labelledby="M2TopProductsHeading-{{ section.id }}">
    <img
      class="m2-top-haze m2-top-products__drop"
      src="{{ 'm2-top-drop-05.png' | asset_url }}"
      alt=""
      width="800"
      height="818"
      loading="lazy"
    >

    <div class="m2-top-heading m2-top-heading--center">
      <p class="m2-top-label">{{ section.settings.eyebrow | escape }}</p>
      <h2 id="M2TopProductsHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    </div>

    {%- if selected_collection != blank and selected_collection.products_count > 0 -%}
      <div class="m2-top-products__grid">
        {%- for product in selected_collection.products limit: section.settings.products_to_show -%}
          {%- liquid
            assign top_feature_badge = blank
            if section.settings.show_feature_badges
              if forloop.index == 1
                assign top_feature_badge = section.settings.feature_badge_1
              elsif forloop.index == 2
                assign top_feature_badge = section.settings.feature_badge_2
              endif
            endif
          -%}
          {% render 'm2-product-card',
            card_product: product,
            feature_badge: top_feature_badge,
            description_text: product.description,
            show_description: section.settings.show_description,
            show_feature_badge: section.settings.show_feature_badges,
            image_sizes: '(min-width: 1024px) 350px, 82vw'
          %}
        {%- endfor -%}
      </div>

      {%- if section.settings.show_view_all and selected_collection.url != blank -%}
        <div class="m2-top-products__action">
          <a class="m2-top-button" href="{{ selected_collection.url }}">{{ section.settings.view_all_label | escape }}</a>
        </div>
      {%- endif -%}
    {%- elsif request.design_mode -%}
      <p class="m2-top-editor-note">テーマエディターで表示するコレクションを選択してください。</p>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "M2 TOP 商品一覧",
  "tag": "div",
  "class": "m2-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "英字見出し", "default": "PRODUCTS" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "商品ラインナップ" },
    { "type": "collection", "id": "collection", "label": "コレクション" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 6, "step": 1, "label": "表示商品数", "default": 3 },
    { "type": "checkbox", "id": "show_description", "label": "商品説明を表示", "default": true },
    { "type": "checkbox", "id": "show_feature_badges", "label": "特徴バッジを表示", "default": true },
    { "type": "textarea", "id": "feature_badge_1", "label": "1商品目の特徴", "default": "高濃度\nコラーゲン\n6000mg" },
    { "type": "textarea", "id": "feature_badge_2", "label": "2商品目の特徴", "default": "コラーゲン\n＋\nPDRN" },
    { "type": "checkbox", "id": "show_view_all", "label": "一覧リンクを表示", "default": false },
    { "type": "text", "id": "view_all_label", "label": "一覧リンク名", "default": "VIEW ALL" }
  ],
  "presets": [{ "name": "M2 TOP 商品一覧" }]
}
{% endschema %}
