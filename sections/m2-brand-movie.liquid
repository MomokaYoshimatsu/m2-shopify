{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign video = section.settings.video
  assign video_url = section.settings.video_url
  assign video_id = video.id | default: video_url.id
  assign poster = video.preview_image | default: section.settings.poster
  assign has_video = false
  if video != blank or video_url != blank
    assign has_video = true
  endif
-%}

<section class="m2-top-movie m2-top-width" aria-labelledby="M2TopMovieHeading-{{ section.id }}">
  <img
    class="m2-top-haze m2-top-movie__drop"
    src="{{ 'm2-top-drop-01.png' | asset_url }}"
    alt=""
    width="1000"
    height="1022"
    loading="lazy"
  >

  <div class="m2-top-heading m2-top-heading--split">
    <p class="m2-top-label">{{ section.settings.eyebrow | escape }}</p>
    <h2 id="M2TopMovieHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  </div>

  {%- if has_video -%}
    <deferred-media class="m2-top-movie__media deferred-media" data-media-id="{{ video_id }}">
      <button
        id="Deferred-Poster-M2-{{ section.id }}"
        class="m2-top-movie__poster deferred-media__poster"
        type="button"
        aria-label="{{ section.settings.play_label | escape }}"
      >
        {%- if poster != blank -%}
          {{
            poster
            | image_url: width: 2200
            | image_tag:
              widths: '600, 900, 1200, 1600, 2200',
              sizes: '(min-width: 1200px) 1100px, calc(100vw - 40px)',
              loading: 'lazy'
          }}
        {%- else -%}
          <img src="{{ 'm2-top-brand-movie.jpg' | asset_url }}" alt="" width="1280" height="720" loading="lazy">
        {%- endif -%}
        <span class="m2-top-movie__play" aria-hidden="true"><span></span></span>
      </button>
      <template>
        {%- if video != blank -%}
          {{ video | video_tag: image_size: '2200x', autoplay: true, controls: true, preload: 'metadata' }}
        {%- elsif video_url.type == 'youtube' -%}
          <iframe
            src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1&autoplay=1"
            class="js-youtube"
            allow="autoplay; encrypted-media; picture-in-picture"
            allowfullscreen
            title="{{ section.settings.play_label | escape }}"
          ></iframe>
        {%- else -%}
          <iframe
            src="https://player.vimeo.com/video/{{ video_id }}?autoplay=1"
            class="js-vimeo"
            allow="autoplay; encrypted-media; picture-in-picture"
            allowfullscreen
            title="{{ section.settings.play_label | escape }}"
          ></iframe>
        {%- endif -%}
      </template>
    </deferred-media>
  {%- else -%}
    <div class="m2-top-movie__media">
      {%- if poster != blank -%}
        {{ poster | image_url: width: 2200 | image_tag: loading: 'lazy' }}
      {%- else -%}
        <img src="{{ 'm2-top-brand-movie.jpg' | asset_url }}" alt="" width="1280" height="720" loading="lazy">
      {%- endif -%}
      <span class="m2-top-movie__play m2-top-movie__play--disabled" aria-hidden="true"><span></span></span>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "M2 TOP BRAND MOVIE",
  "tag": "div",
  "class": "m2-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "英字見出し", "default": "BRAND MOVIE" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "360度、自信に満ちた輝きへ。" },
    { "type": "video", "id": "video", "label": "Shopifyにアップロードした動画" },
    { "type": "image_picker", "id": "poster", "label": "動画サムネイル" },
    { "type": "video_url", "id": "video_url", "label": "YouTube / Vimeo URL", "accept": ["youtube", "vimeo"] },
    { "type": "text", "id": "play_label", "label": "再生ボタンの説明", "default": "ブランドムービーを再生" }
  ],
  "presets": [{ "name": "M2 TOP BRAND MOVIE" }]
}
{% endschema %}
