{%- liquid
  assign page_content = product.metafields.custom.product_page_content.value
  assign features = page_content.features.value
  assign support_items = page_content.support_items.value
  assign free_formula_items = page_content.free_formula_items.value
  assign how_to_items = page_content.how_to_items.value
  assign specs = page_content.specs.value
  assign faqs = page_content.faqs.value
  assign related_products = page_content.related_products.value
-%}

{%- if page_content != blank -%}
  <div class="m2-pdp" data-m2-product-content>
    {%- if page_content.overview_eyebrow.value != blank
      or page_content.overview_heading.value != blank
      or page_content.overview_body.value != blank
      or page_content.recommended_items.value != blank
    -%}
      <section class="m2-pdp-overview" aria-labelledby="M2ProductOverview-{{ section.id }}">
        <div class="m2-pdp-width">
          <header class="m2-pdp-heading m2-pdp-heading--overview">
            {%- if page_content.overview_eyebrow.value != blank -%}
              <p class="m2-pdp-heading__eyebrow">{{ page_content.overview_eyebrow.value | escape }}</p>
            {%- endif -%}
            {%- if page_content.overview_heading.value != blank -%}
              <h2 id="M2ProductOverview-{{ section.id }}">{{ page_content.overview_heading.value | escape }}</h2>
            {%- endif -%}
          </header>

          <div class="m2-pdp-overview__grid">
            <div class="m2-pdp-overview__content">
              {%- if page_content.overview_badge.value != blank or page_content.overview_lead.value != blank -%}
                <div class="m2-pdp-overview__lead">
                  {%- if page_content.overview_badge.value != blank -%}
                    <span>{{ page_content.overview_badge.value | escape }}</span>
                  {%- endif -%}
                  {%- if page_content.overview_lead.value != blank -%}
                    <h3>{{ page_content.overview_lead.value | escape }}</h3>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if page_content.tags.value != blank -%}
                <ul class="m2-pdp-tags" role="list">
                  {%- for tag_text in page_content.tags.value -%}
                    {%- if tag_text != blank -%}<li>{{ tag_text | escape }}</li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              {%- if page_content.overview_body.value != blank -%}
                <div class="m2-pdp-richtext">{{ page_content.overview_body | metafield_tag }}</div>
              {%- endif -%}

              {%- if page_content.recommended_items.value != blank -%}
                <div class="m2-pdp-recommended">
                  {%- if page_content.recommended_heading.value != blank -%}
                    <h3>{{ page_content.recommended_heading.value | escape }}</h3>
                  {%- endif -%}
                  <ul role="list">
                    {%- for recommended_item in page_content.recommended_items.value -%}
                      {%- if recommended_item != blank -%}<li>{{ recommended_item | escape }}</li>{%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}
            </div>

            {%- if product.featured_image != blank -%}
              {%- assign overview_image_alt = product.featured_image.alt | default: product.title -%}
              <div class="m2-pdp-overview__media">
                {{
                  product.featured_image
                  | image_url: width: 900
                  | image_tag:
                    widths: '320, 480, 640, 760, 900',
                    sizes: '(min-width: 1024px) 28rem, 70vw',
                    loading: 'lazy',
                    alt: overview_image_alt
                }}
              </div>
            {%- endif -%}
          </div>
        </div>
      </section>
    {%- endif -%}

    {%- if features != blank -%}
      <section class="m2-pdp-formula" aria-labelledby="M2ProductFormula-{{ section.id }}">
        <header class="m2-pdp-heading">
          {%- if page_content.features_eyebrow.value != blank -%}
            <p class="m2-pdp-heading__eyebrow">{{ page_content.features_eyebrow.value | escape }}</p>
          {%- endif -%}
          {%- if page_content.features_heading.value != blank -%}
            <h2 id="M2ProductFormula-{{ section.id }}">{{ page_content.features_heading.value | escape }}</h2>
          {%- endif -%}
        </header>

        <div class="m2-pdp-feature-grid">
          {%- for feature_item in features -%}
            {%- liquid
              assign feature_image = feature_item.image.value
              assign feature_alt = feature_item.image_alt.value | default: feature_image.alt
            -%}
            {%- if feature_item.heading.value != blank or feature_item.body.value != blank or feature_image != blank -%}
              <article class="m2-pdp-feature{% if forloop.first %} m2-pdp-feature--featured{% endif %}">
                <div class="m2-pdp-feature__content">
                  <div class="m2-pdp-feature__title">
                    {%- if feature_item.number.value != blank -%}
                      <span>{{ feature_item.number.value | escape }}</span>
                    {%- endif -%}
                    {%- if feature_item.heading.value != blank -%}
                      <h3>{{ feature_item.heading.value | escape }}</h3>
                    {%- endif -%}
                  </div>
                  {%- if feature_item.body.value != blank -%}
                    <div class="m2-pdp-richtext">{{ feature_item.body | metafield_tag }}</div>
                  {%- endif -%}
                </div>
                {%- if feature_image != blank -%}
                  <div class="m2-pdp-feature__media">
                    {{
                      feature_image
                      | image_url: width: 1200
                      | image_tag:
                        widths: '360, 540, 720, 900, 1200',
                        sizes: '(min-width: 1024px) 52rem, 100vw',
                        loading: 'lazy',
                        alt: feature_alt
                    }}
                  </div>
                {%- endif -%}
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if support_items != blank -%}
          <div class="m2-pdp-width">
            <div class="m2-pdp-support">
              <header class="m2-pdp-heading m2-pdp-heading--inverse">
                {%- if page_content.support_eyebrow.value != blank -%}
                  <p class="m2-pdp-heading__eyebrow">{{ page_content.support_eyebrow.value | escape }}</p>
                {%- endif -%}
                {%- if page_content.support_heading.value != blank -%}
                  <h2>{{ page_content.support_heading.value | escape }}</h2>
                {%- endif -%}
              </header>
              <div class="m2-pdp-support__grid">
                {%- for support_item in support_items -%}
                  {%- liquid
                    assign support_image = support_item.image.value
                    assign support_alt = support_item.image_alt.value | default: support_image.alt
                  -%}
                  <article class="m2-pdp-support-card">
                    {%- if support_item.number.value != blank -%}
                      <span class="m2-pdp-support-card__number">{{ support_item.number.value | escape }}</span>
                    {%- endif -%}
                    {%- if support_item.heading.value != blank -%}
                      <h3>{{ support_item.heading.value | escape }}</h3>
                    {%- endif -%}
                    {%- if support_image != blank -%}
                      <div class="m2-pdp-support-card__media">
                        {{
                          support_image
                          | image_url: width: 900
                          | image_tag:
                            widths: '360, 540, 720, 900',
                            sizes: '(min-width: 1024px) 40rem, 100vw',
                            loading: 'lazy',
                            alt: support_alt
                        }}
                      </div>
                    {%- endif -%}
                    {%- if support_item.lead.value != blank -%}
                      <p class="m2-pdp-support-card__lead">{{ support_item.lead.value | escape }}</p>
                    {%- endif -%}
                    {%- if support_item.body.value != blank -%}
                      <div class="m2-pdp-richtext">{{ support_item.body | metafield_tag }}</div>
                    {%- endif -%}
                  </article>
                {%- endfor -%}
              </div>
            </div>
          </div>
        {%- endif -%}

        {%- if free_formula_items != blank -%}
          <div class="m2-pdp-width m2-pdp-free-formula">
            <header class="m2-pdp-heading">
              {%- if page_content.free_formula_eyebrow.value != blank -%}
                <p class="m2-pdp-heading__eyebrow">{{ page_content.free_formula_eyebrow.value | escape }}</p>
              {%- endif -%}
              {%- if page_content.free_formula_heading.value != blank -%}
                <h2>{{ page_content.free_formula_heading.value | escape | newline_to_br }}</h2>
              {%- endif -%}
            </header>
            <ul role="list">
              {%- for free_formula_item in free_formula_items -%}
                {%- if free_formula_item != blank -%}<li>{{ free_formula_item | escape | newline_to_br }}</li>{%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </section>
    {%- endif -%}

    {%- if how_to_items != blank -%}
      <section class="m2-pdp-how-to" aria-labelledby="M2ProductHowTo-{{ section.id }}">
        <div class="m2-pdp-width">
          <header class="m2-pdp-heading">
            {%- if page_content.how_to_eyebrow.value != blank -%}
              <p class="m2-pdp-heading__eyebrow">{{ page_content.how_to_eyebrow.value | escape }}</p>
            {%- endif -%}
            {%- if page_content.how_to_heading.value != blank -%}
              <h2 id="M2ProductHowTo-{{ section.id }}">{{ page_content.how_to_heading.value | escape }}</h2>
            {%- endif -%}
          </header>
          <div class="m2-pdp-how-to__grid">
            {%- for how_to_item in how_to_items -%}
              {%- liquid
                assign how_to_image = how_to_item.image.value
                assign how_to_alt = how_to_item.image_alt.value | default: how_to_image.alt
              -%}
              <article class="m2-pdp-how-to-card">
                {%- if how_to_image != blank -%}
                  <div class="m2-pdp-how-to-card__media">
                    {{
                      how_to_image
                      | image_url: width: 800
                      | image_tag:
                        widths: '320, 480, 640, 800',
                        sizes: '(min-width: 1024px) 33rem, 82vw',
                        loading: 'lazy',
                        alt: how_to_alt
                    }}
                  </div>
                {%- endif -%}
                {%- if how_to_item.body.value != blank -%}
                  <div class="m2-pdp-richtext">{{ how_to_item.body | metafield_tag }}</div>
                {%- endif -%}
              </article>
            {%- endfor -%}
          </div>
        </div>
      </section>
    {%- endif -%}

    {%- if specs != blank or page_content.notice_body.value != blank -%}
      <section class="m2-pdp-specs" aria-labelledby="M2ProductSpecs-{{ section.id }}">
        <div class="m2-pdp-width">
          <header class="m2-pdp-heading">
            {%- if page_content.specs_eyebrow.value != blank -%}
              <p class="m2-pdp-heading__eyebrow">{{ page_content.specs_eyebrow.value | escape }}</p>
            {%- endif -%}
            {%- if page_content.specs_heading.value != blank -%}
              <h2 id="M2ProductSpecs-{{ section.id }}">{{ page_content.specs_heading.value | escape }}</h2>
            {%- endif -%}
          </header>
          {%- if specs != blank -%}
            <dl class="m2-pdp-spec-list">
              {%- for spec_item in specs -%}
                {%- if spec_item.label.value != blank and spec_item.value.value != blank -%}
                  <div class="m2-pdp-spec-row{% if spec_item.emphasis.value %} m2-pdp-spec-row--emphasis{% endif %}">
                    <dt>{{ spec_item.label.value | escape }}</dt>
                    <dd>{{ spec_item.value | metafield_tag }}</dd>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </dl>
          {%- endif -%}
          {%- if page_content.notice_heading.value != blank or page_content.notice_body.value != blank -%}
            <div class="m2-pdp-notice">
              {%- if page_content.notice_heading.value != blank -%}
                <h3>{{ page_content.notice_heading.value | escape }}</h3>
              {%- endif -%}
              {%- if page_content.notice_body.value != blank -%}
                <div class="m2-pdp-richtext">{{ page_content.notice_body | metafield_tag }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </section>
    {%- endif -%}

    {%- if faqs != blank -%}
      <section class="m2-pdp-faq" aria-labelledby="M2ProductFaq-{{ section.id }}">
        <div class="m2-pdp-width">
          <header class="m2-pdp-heading">
            {%- if page_content.faq_eyebrow.value != blank -%}
              <p class="m2-pdp-heading__eyebrow">{{ page_content.faq_eyebrow.value | escape }}</p>
            {%- endif -%}
            {%- if page_content.faq_heading.value != blank -%}
              <h2 id="M2ProductFaq-{{ section.id }}">{{ page_content.faq_heading.value | escape }}</h2>
            {%- endif -%}
          </header>
          <div class="m2-pdp-faq__list">
            {%- for faq_item in faqs -%}
              {%- if faq_item.question.value != blank -%}
                <details class="m2-pdp-faq-item">
                  <summary>
                    <span class="m2-pdp-faq-item__q" aria-hidden="true">Q</span>
                    <span>{{ faq_item.question.value | escape }}</span>
                    <span class="m2-pdp-faq-item__icon" aria-hidden="true"></span>
                  </summary>
                  {%- if faq_item.answer.value != blank -%}
                    <div class="m2-pdp-faq-item__answer">{{ faq_item.answer | metafield_tag }}</div>
                  {%- endif -%}
                </details>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </section>
    {%- endif -%}

    {%- if related_products != blank -%}
      {{ 'component-price.css' | asset_url | stylesheet_tag }}
      <section class="m2-pdp-related" aria-labelledby="M2ProductRelated-{{ section.id }}">
        <div class="m2-pdp-width">
          <header class="m2-pdp-heading">
            {%- if page_content.related_eyebrow.value != blank -%}
              <p class="m2-pdp-heading__eyebrow">{{ page_content.related_eyebrow.value | escape }}</p>
            {%- endif -%}
            {%- if page_content.related_heading.value != blank -%}
              <h2 id="M2ProductRelated-{{ section.id }}">{{ page_content.related_heading.value | escape }}</h2>
            {%- endif -%}
          </header>
          <div class="m2-pdp-related__grid">
            {%- for related_product in related_products -%}
              {%- liquid
                assign related_page_content = related_product.metafields.custom.product_page_content.value
                assign related_image_alt = related_product.featured_image.alt | default: related_product.title
              -%}
              <article class="m2-pdp-related-card">
                {%- if related_page_content.card_badge.value != blank -%}
                  <span class="m2-pdp-related-card__feature">{{ related_page_content.card_badge.value | escape | newline_to_br }}</span>
                {%- endif -%}
                <a class="m2-pdp-related-card__media" href="{{ related_product.url }}" tabindex="-1" aria-hidden="true">
                  {%- if related_product.featured_image != blank -%}
                    {{
                      related_product.featured_image
                      | image_url: width: 900
                      | image_tag:
                        widths: '360, 540, 720, 900',
                        sizes: '(min-width: 1024px) 35rem, 84vw',
                        loading: 'lazy',
                        alt: related_image_alt
                    }}
                  {%- else -%}
                    {{ 'product-apparel-2' | placeholder_svg_tag: 'm2-pdp-related-card__placeholder' }}
                  {%- endif -%}
                </a>
                <div class="m2-pdp-related-card__body">
                  {%- if related_page_content.badge.value != blank -%}
                    <span class="m2-pdp-related-card__badge">{{ related_page_content.badge.value | escape }}</span>
                  {%- endif -%}
                  <h3><a href="{{ related_product.url }}">{{ related_product.title | escape }}</a></h3>
                  {%- if related_product.description != blank -%}
                    <p>{{ related_product.description | strip_html | truncate: 110 }}</p>
                  {%- endif -%}
                  <div class="m2-pdp-related-card__meta">
                    <span>{{ related_page_content.package_summary.value | escape }}</span>
                    {% render 'price', product: related_product, price_class: '', show_compare_at_price: true %}
                  </div>
                </div>
              </article>
            {%- endfor -%}
          </div>
        </div>
      </section>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "M2 商品ページコンテンツ",
  "tag": "div",
  "class": "m2-product-page-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "商品メタフィールド custom.product_page_content に紐づくMetaobjectを表示します。未設定の場合は何も表示しません。"
    }
  ],
  "presets": [
    {
      "name": "M2 商品ページコンテンツ"
    }
  ]
}
{% endschema %}
